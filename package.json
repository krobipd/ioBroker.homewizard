{
  "name": "iobroker.homewizard",
  "version": "0.18.2",
  "description": "ioBroker adapter for HomeWizard Energy devices with API v2",
  "author": {
    "name": "krobi",
    "email": "krobi@power-dreams.com"
  },
  "contributors": [
    {
      "name": "Claude (Anthropic)",
      "role": "Coding assistance"
    }
  ],
  "homepage": "https://github.com/krobipd/ioBroker.homewizard",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "homewizard",
    "energy",
    "p1",
    "meter",
    "smartmeter",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/krobipd/ioBroker.homewizard"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "bonjour-service": "^1.4.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.1.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.19.17",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "iobroker-adapter-checks": "^0.6.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "files": [
    "admin",
    "build",
    "io-package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "check": "tsc --noEmit",
    "test:ts": "vitest run",
    "test:unit": "vitest run",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test:inventory": "mocha test/inventory.js --exit",
    "test": "npm run test:ts && npm run test:package",
    "coverage": "vitest run --coverage",
    "translate": "translate-adapter",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fix:changelog": "node -e \"const fs=require('fs');for(const[f,r]of[['README.md',/^(-->[ \\t]*)\\r?\\n(#{1,6} )/m],['CHANGELOG_OLD.md',/^(#{1,6} .*)\\r?\\n(#{1,6} )/]])if(fs.existsSync(f)){const t=fs.readFileSync(f,'utf8'),n=t.replace(r,(m,a,b)=>a+'\\n\\n'+b);if(n!==t)fs.writeFileSync(f,n)}\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,js}\" \"test/self-explaining.json\" \"admin/**/*.json\" \"*.mjs\" \"*.mts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,js}\" \"test/self-explaining.json\" \"admin/**/*.json\" \"*.mjs\" \"*.mts\"",
    "release": "release-script",
    "release-patch": "release-script patch --yes --all",
    "release-minor": "release-script minor --yes --all",
    "release-major": "release-script major --yes --all"
  },
  "bugs": {
    "url": "https://github.com/krobipd/ioBroker.homewizard/issues"
  },
  "main": "build/main.js",
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    },
    "esbuild": ">=0.25.0"
  }
}
